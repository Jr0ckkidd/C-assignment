#include <iostream>

using namespace std;

int main() {
    int num, digit, sum = 0, pwr = 0;
    cin >> num;
    if (num < 0)
        num = -num;
    int temp = num;
    pwr = 1;
    while (temp >= 10)
    {
        temp /= 10;
        pwr *= 10;
    }  
    while (pwr > 0)
    {
        digit = num / pwr;
        cout << digit << " ";
        sum += digit;
        num %= pwr;
        pwr /= 10;
    }
    cout << endl;
    cout << "Sum = " << sum << endl;
    return 0;
}
